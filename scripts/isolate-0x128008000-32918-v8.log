 inumber = inumber.replace('+i'\x2C '+1i').replace('-i'\x2C '-1i').replace('+j'\x2C '+1j').replace('-j'\x2C '-1j');\n\n  // Lookup sign\n  let plus = inumber.indexOf('+');\n  let minus = inumber.indexOf('-');\n\n  if (plus === 0) {\n    plus = inumber.indexOf('+'\x2C 1);\n  }\n\n  if (minus === 0) {\n    minus = inumber.indexOf('-'\x2C 1);\n  }\n\n  // Lookup imaginary unit\n  const last = inumber.substring(inumber.length - 1\x2C inumber.length);\n  const unit = last === 'i' || last === 'j';\n\n  if (plus >= 0 || minus >= 0) {\n    // Return error if imaginary unit is neither i nor j\n    if (!unit) {\n      return num\n    }\n\n    // Return imaginary coefficient of complex number\n    if (plus >= 0) {\n      return isNaN(inumber.substring(0\x2C plus)) || isNaN(inumber.substring(plus + 1\x2C inumber.length - 1))\n        ? num\n        : Number(inumber.substring(plus + 1\x2C inumber.length - 1))\n    } else {\n      return isNaN(inumber.substring(0\x2C minus)) || isNaN(inumber.substring(minus + 1\x2C inumber.length - 1))\n        ? num\n        : -Number(inumber.substring(minus + 1\x2C inumber.length - 1))\n    }\n  } else {\n    if (unit) {\n      return isNaN(inumber.substring(0\x2C inumber.length - 1)) ? num : inumber.substring(0\x2C inumber.length - 1)\n    } else {\n      return isNaN(inumber) ? num : 0\n    }\n  }\n}\n\n/**\n * Returns the argument theta\x2C an angle expressed in radians.\n *\n * Category: Engineering\n *\n * @param {*} inumber A complex number for which you want the argument .\n * @returns\n */\nfunction IMARGUMENT(inumber) {\n  // Lookup real and imaginary coefficients using exports.js [http://formulajs.org]\n  const x = IMREAL(inumber);\n  const y = IMAGINARY(inumber);\n\n  // Return error if either coefficient is not a number\n  if (anyIsError(x\x2C y)) {\n    return value\n  }\n\n  // Return error if inumber is equal to zero\n  if (x === 0 && y === 0) {\n    return div0\n  }\n\n  // Return PI/2 if x is equal to zero and y is positive\n  