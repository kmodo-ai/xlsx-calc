 oneSidedDifferenceOfProportions: function oneSidedDifferenceOfProportions(p1\x2C n1\x2C p2\x2C n2) {\n    var z = differenceOfProportions(p1\x2C n1\x2C p2\x2C n2);\n    return jStat.ztest(z\x2C 1);\n  }\x2C\n\n  twoSidedDifferenceOfProportions: function twoSidedDifferenceOfProportions(p1\x2C n1\x2C p2\x2C n2) {\n    var z = differenceOfProportions(p1\x2C n1\x2C p2\x2C n2);\n    return jStat.ztest(z\x2C 2);\n  }\n});\n\n}(jStat\x2C Math));\njStat.models = (function(){\n  function sub_regress(exog) {\n    var var_count = exog[0].length;\n    var modelList = jStat.arange(var_count).map(function(endog_index) {\n      var exog_index =\n          jStat.arange(var_count).filter(function(i){return i!==endog_index});\n      return ols(jStat.col(exog\x2C endog_index).map(function(x){ return x[0] })\x2C\n                 jStat.col(exog\x2C exog_index))\n    });\n    return modelList;\n  }\n\n  // do OLS model regress\n  // exog have include const columns \x2Cit will not generate it .In fact\x2C exog is\n  // "design matrix" look at\n  //https://en.wikipedia.org/wiki/Design_matrix\n  function ols(endog\x2C exog) {\n    var nobs = endog.length;\n    var df_model = exog[0].length - 1;\n    var df_resid = nobs-df_model - 1;\n    var coef = jStat.lstsq(exog\x2C endog);\n    var predict =\n        jStat.multiply(exog\x2C coef.map(function(x) { return [x] }))\n            .map(function(p) { return p[0] });\n    var resid = jStat.subtract(endog\x2C predict);\n    var ybar = jStat.mean(endog);\n    // constant cause problem\n    // var SST = jStat.sum(endog.map(function(y) {\n    //   return Math.pow(y-ybar\x2C2);\n    // }));\n    var SSE = jStat.sum(predict.map(function(f) {\n      return Math.pow(f - ybar\x2C 2);\n    }));\n    var SSR = jStat.sum(endog.map(function(y\x2C i) {\n      return Math.pow(y - predict[i]\x2C 2);\n    }));\n    var SST = SSE + SSR;\n    var R2 = (SSE / SST);\n    return {\n        exog:exog\x2C\n        endog:endog\x2C\n        nobs:nobs\x2C\n        df_model:df_model\x2C\n        df_resid:df_resid\x2C\n        coef:coef\x2C\n        predict:predict\x2C\n        resid:resid\x2C\n        ybar:ybar\x2C\n        SST:SST\x2C\n        SSE:SSE\x2C\n        SSR:SSR\x2C\n        R2:R2\n    };\n  }\n\n  // H0: b_I=0\n  // H1: b_I!=0\n  function t_test(model) {\n    var subModelList = sub_regress(model.exog);\n    //var sigmaHat=jStat.stdev(model.resid);\n    var sigmaHat = Math.sqrt(model.SSR / (model.df_resid));\n    var seBetaHat = subModelList.map(function(mod) {\n      var SST = mod.SST;\n      var R2 = mod.R2;\n      return sigmaHat / Math.sqrt(SST * (1 - R2));\n    });\n    var tStatistic = model.coef.map(function(coef\x2C i) {\n      return (coef - 0) / seBetaHat[i];\n    });\n    var pValue = tStatistic.map(function(t) {\n      var leftppf = jStat.studentt.cdf(t\x2C model.df_resid);\n      return (leftppf > 0.5 ? 1 - leftppf : leftppf) * 2;\n    });\n    var c = jStat.studentt.inv(0.975\x2C model.df_resid);\n    var interval95 = model.coef.map(function(coef\x2C i) {\n      var d = c * seBetaHat[i];\n      return [coef - d\x2C coef + d];\n    })\n    return {\n        se: seBetaHat\x2C\n        t: tStatistic\x2C\n        p: pValue\x2C\n        sigmaHat: sigmaHat\x2C\n        interval95: interval95\n    };\n  }\n\n  function F_test(model) {\n    var F_statistic =\n        (model.R2 / model.df_model) / ((1 - model.R2) / model.df_resid);\n    var fcdf = function(x\x2C n1\x2C n2) {\n      return jStat.beta.cdf(x / (n2 / n1 + x)\x2C n1 / 2\x2C n2 / 2)\n    }\n    var pvalue = 1 - fcdf(F_statistic\x2C model.df_model\x2C model.df_resid);\n    return { F_statistic: F_statistic\x2C pvalue: pvalue };\n  }\n\n  function ols_wrap(endog\x2C exog) {\n    var model = ols(endog\x2Cexog);\n    var ttest = t_test(model);\n    var ftest = F_test(model);\n    // Provide the Wherry / Ezekiel / McNemar / Cohen Adjusted R^2\n    // Which matches the 'adjusted R^2' provided by R's lm package\n    var adjust_R2 =\n        1 - (1 - model.R2) * ((model.nobs - 1) / (model.df_resid));\n    model.t = ttest;\n    model.f = ftest;\n    model.adjust_R2 = adjust_R2;\n    return model;\n  }\n\n  return { ols: ols_wrap };\n})();\n//To regress\x2C simply build X matrix\n//(append column of 1's) using\n//buildxmatrix and build the Y\n//matrix using buildymatrix\n//(simply the transpose)\n//and run regress.\n\n\n\n//Regressions\n\njStat.extend({\n  buildxmatrix: function buildxmatrix(){\n    //Parameters will be passed in as such\n    //(array1\x2Carray2\x2Carray3\x2C...)\n    //as (x1\x2Cx2\x2Cx3\x2C...)\n    //needs to be (1\x2Cx1\x2Cx2\x2Cx3\x2C...)\n    var matrixRows = new Array(arguments.length);\n    for(var i=0;i<arguments.length;i++){\n      var array = [1];\n      matrixRows[i]= array.concat(arguments[i]);\n    }\n    return jStat(matrixRows);\n\n  }\x2C\n\n  builddxmatrix: function builddxmatrix() {\n    //Paramters will be passed in as such\n    //([array1\x2Carray2\x2C...]\n    var matrixRows = new Array(arguments[0].length);\n    for(var i=0;i<arguments[0].length;i++){\n      var array = [1]\n      matrixRows[i]= array.concat(arguments[0][i]);\n    }\n    return jStat(matrixRows);\n\n  }\x2C\n\n  buildjxmatrix: function buildjxmatrix(jMat) {\n    //Builds from jStat Matrix\n    var pass = new Array(jMat.length)\n    for(var i=0;i<jMat.length;i++){\n      pass[i] = jMat[i];\n    }\n    return jStat.builddxmatrix(pass);\n\n  }\x2C\n\n  buildymatrix: function buildymatrix(array){\n    return jStat(array).transpose();\n  }\x2C\n\n  buildjymatrix: function buildjymatrix(jMat){\n    return jMat.transpose();\n  }\x2C\n\n  matrixmult: function matrixmult(A\x2CB){\n    var i\x2C j\x2C k\x2C result\x2C sum;\n    if (A.cols() == B.rows()) {\n      if(B.rows()>1){\n        result = [];\n        for (i = 0; i < A.rows(); i++) {\n          result[i] = [];\n          for (j = 0; j < B.cols(); j++) {\n            sum = 0;\n            for (k = 0; k < A.cols(); k++) {\n              sum += A.toArray()[i][k] * B.toArray()[k][j];\n            }\n            result[i][j] = sum;\n          }\n        }\n        return jStat(result);\n      }\n      result = [];\n      for (i = 0; i < A.rows(); i++) {\n        result[i] = [];\n        for (j = 0; j < B.cols(); j++) {\n          sum = 0;\n          for (k = 0; k < A.cols(); k++) {\n            sum += A.toArray()[i][k] * B.toArray()[j];\n          }\n          result[i][j] = sum;\n        }\n      }\n      return jStat(result);\n    }\n  }\x2C\n\n  //regress and regresst to be fixed\n\n  regress: function regress(jMatX\x2CjMatY){\n    //print("regressin!");\n    //print(jMatX.toArray());\n    var innerinv = jStat.xtranspxinv(jMatX);\n    //print(innerinv);\n    var xtransp = jMatX.transpose();\n    var next = jStat.matrixmult(jStat(innerinv)\x2Cxtransp);\n    return jStat.matrixmult(next\x2CjMatY);\n\n  }\x2C\n\n  regresst: function regresst(jMatX\x2CjMatY\x2Csides){\n    var beta = jStat.regress(jMatX\x2CjMatY);\n\n    var compile = {};\n    compile.anova = {};\n    var jMatYBar = jStat.jMatYBar(jMatX\x2C beta);\n    compile.yBar = jMatYBar;\n    var yAverage = jMatY.mean();\n    compile.anova.residuals = jStat.residuals(jMatY\x2C jMatYBar);\n\n    compile.anova.ssr = jStat.ssr(jMatYBar\x2C yAverage);\n    compile.anova.msr = compile.anova.ssr / (jMatX[0].length - 1);\n\n    compile.anova.sse = jStat.sse(jMatY\x2C jMatYBar);\n    compile.anova.mse =\n        compile.anova.sse / (jMatY.length - (jMatX[0].length - 1) - 1);\n\n    compile.anova.sst = jStat.sst(jMatY\x2C yAverage);\n    compile.anova.mst = compile.anova.sst / (jMatY.length - 1);\n\n    compile.anova.r2 = 1 - (compile.anova.sse / compile.anova.sst);\n    if (compile.anova.r2 < 0) compile.anova.r2 = 0;\n\n    compile.anova.fratio = compile.anova.msr / compile.anova.mse;\n    compile.anova.pvalue =\n        jStat.anovaftest(compile.anova.fratio\x2C\n                         jMatX[0].length - 1\x2C\n                         jMatY.length - (jMatX[0].length - 1) - 1);\n\n    compile.anova.rmse = Math.sqrt(compile.anova.mse);\n\n    compile.anova.r2adj = 1 - (compile.anova.mse / compile.anova.mst);\n    if (compile.anova.r2adj < 0) compile.anova.r2adj = 0;\n\n    compile.stats = new Array(jMatX[0].length);\n    var covar = jStat.xtranspxinv(jMatX);\n    var sds\x2C ts\x2C ps;\n\n    for(var i=0; i<beta.length;i++){\n      sds=Math.sqrt(compile.anova.mse * Math.abs(covar[i][i]));\n      ts= Math.abs(beta[i] / sds);\n      ps= jStat.ttest(ts\x2C jMatY.length - jMatX[0].length - 1\x2C sides);\n\n      compile.stats[i]=[beta[i]\x2C sds\x2C ts\x2C ps];\n    }\n\n    compile.regress = beta;\n    return compile;\n  }\x2C\n\n  xtranspx: function xtranspx(jMatX){\n    return jStat.matrixmult(jMatX.transpose()\x2CjMatX);\n  }\x2C\n\n\n  xtranspxinv: function xtranspxinv(jMatX){\n    var inner = jStat.matrixmult(jMatX.transpose()\x2CjMatX);\n    var innerinv = jStat.inv(inner);\n    return innerinv;\n  }\x2C\n\n  jMatYBar: function jMatYBar(jMatX\x2C beta) {\n    var yBar = jStat.matrixmult(jMatX\x2C beta);\n    return new jStat(yBar);\n  }\x2C\n\n  residuals: function residuals(jMatY\x2C jMatYBar) {\n    return jStat.matrixsubtract(jMatY\x2C jMatYBar);\n  }\x2C\n\n  ssr: function ssr(jMatYBar\x2C yAverage) {\n    var ssr = 0;\n    for(var i = 0; i < jMatYBar.length; i++) {\n      ssr += Math.pow(jMatYBar[i] - yAverage\x2C 2);\n    }\n    return ssr;\n  }\x2C\n\n  sse: function sse(jMatY\x2C jMatYBar) {\n    var sse = 0;\n    for(var i = 0; i < jMatY.length; i++) {\n      sse += Math.pow(jMatY[i] - jMatYBar[i]\x2C 2);\n    }\n    return sse;\n  }\x2C\n\n  sst: function sst(jMatY\x2C yAverage) {\n    var sst = 0;\n    for(var i = 0; i < jMatY.length; i++) {\n      sst += Math.pow(jMatY[i] - yAverage\x2C 2);\n    }\n    return sst;\n  }\x2C\n\n  matrixsubtract: function matrixsubtract(A\x2CB){\n    var ans = new Array(A.length);\n    for(var i=0;i<A.length;i++){\n      ans[i] = new Array(A[i].length);\n      for(var j=0;j<A[i].length;j++){\n        ans[i][j]=A[i][j]-B[i][j];\n      }\n    }\n    return jStat(ans);\n  }\n});\n  // Make it compatible with previous version.\n  jStat.jStat = jStat;\n\n  return jStat;\n});\n
