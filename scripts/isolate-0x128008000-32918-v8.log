script-source,81,/Users/lukedunscombe/src/kmodo/xlsx-calc/scripts/benchmark.js,const XLSX = require('xlsx')\nconst XLSX_CALC = require("../src");\nconst fs = require('fs');\nconst formulajs = require('@formulajs/formulajs');\nconst cliProgress = require('cli-progress');\n\nconst bar = new cliProgress.SingleBar({}\x2C cliProgress.Presets.shades_classic);\n\n\nXLSX_CALC.import_functions(\n    {\n        ...formulajs\x2C\n        TEXTSPLIT: (value\x2C col_del\x2C row_del) => {\n            return typeof value === 'string' && typeof row_del === 'string'\n                ? value.split(row_del)\n                : new Error('#VALUE!');\n        }\x2C\n        VALUE: (text) => {\n            // The VALUE function casts empty string to 0: https://github.com/formulajs/formulajs/blob/master/src/text.js#L742\n            return text === '' ? '' : formulajs.VALUE(text);\n        }\x2C\n    }\x2C\n    { override: true }\x2C\n);\n\n\nconst file = fs.readFileSync(`${__dirname}/custom_term_pricing.xlsx`);\nconst wb = XLSX.read(file);\n\nconst times = []\nconst n = 1;\n\nbar.start(n\x2C 0);\nfor (let i = 0; i < n; i++) {\n    const t0 = performance.now();\n    XLSX_CALC(wb);\n    const t1 = performance.now();\n    const previous = t1-t0;\n    times.push(previous)\n    bar.increment();\n}\n\nbar.stop();\n\nconst average = (times.reduce((sum\x2C t) => sum +t\x2C 0))/n;\nconsole.log(`\\n\\nAverage time for ${n} executions: ${average}`)\n
