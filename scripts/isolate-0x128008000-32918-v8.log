script-source,134,/Users/lukedunscombe/src/kmodo/xlsx-calc/src/errors.js,const nil = new Error('#NULL!')\nconst div0 = new Error('#DIV/0!')\nconst value = new Error('#VALUE!')\nconst ref = new Error('#REF!')\nconst name = new Error('#NAME?')\nconst num = new Error('#NUM!')\nconst na = new Error('#N/A')\nconst error = new Error('#ERROR!')\nconst data = new Error('#GETTING_DATA')\nconst calc = new Error('#CALC!')\n\nconst ERROR_MESSAGE_TO_VALUE = {\n    '#NULL!': 0x00\x2C\n    '#DIV/0!': 0x07\x2C\n    '#VALUE!': 0x0F\x2C\n    '#REF!': 0x17\x2C\n    '#NAME?': 0x1D\x2C\n    '#NUM!': 0x24\x2C\n    '#N/A': 0x2A\x2C\n    '#GETTING_DATA': 0x2B\x2C\n    '#CALC!': 0x00\x2C // todo: set the correct error code\n};\n\nfunction getErrorValueByMessage(errorMessage) {\n    return ERROR_MESSAGE_TO_VALUE[errorMessage]\n}\n\nmodule.exports = {\n    nil\x2C\n    div0\x2C\n    value\x2C\n    ref\x2C\n    name\x2C\n    num\x2C\n    na\x2C\n    error\x2C\n    data\x2C\n    calc\x2C\n    getErrorValueByMessage\x2C\n}
