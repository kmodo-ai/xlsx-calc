script-source,130,/Users/lukedunscombe/src/kmodo/xlsx-calc/src/str_2_val.js,const RawValue = require('./RawValue.js');\nconst RefValue = require('./RefValue.js');\nconst LazyValue = require('./LazyValue.js');\nconst Range = require('./Range.js');\n\n// this is used to _cache_ range names so that it doesn't need to be queried\n// every time a range is used\nlet definedNames\x2C wb;\nfunction getDefinedName(buffer\x2C formula) {\n    if (!(formula.wb.Workbook && formula.wb.Workbook.Names)) {\n        return null;\n    }\n    if (wb !== formula.wb) {\n        wb = formula.wb;\n        definedNames = null;\n        return getDefinedName(buffer\x2C formula);\n    }\n    if (definedNames) {\n        return definedNames[buffer];\n    }\n    const keys = Object.values(formula.wb.Workbook.Names);\n    if (keys.length === 0) {\n        return;\n    }\n    definedNames = {};\n    keys.forEach(({ Name\x2C Ref }) => {\n        if (!Name.includes('.')) {\n            definedNames[Name] = Ref;\n        }\n    });\n\n    return getDefinedName(buffer\x2C formula);\n}\n\nmodule.exports = function str_2_val(buffer\x2C formula) {\n    if (!isNaN(buffer)) {\n        return new RawValue(+buffer);\n    }\n    if (buffer === 'TRUE') {\n        return new RawValue(1);\n    }\n    if (buffer === 'FALSE') {\n        return new RawValue(0);\n    }\n    if (typeof buffer !== 'string') {\n        return buffer;\n    }\n\n    buffer = buffer.trim().replace(/\\$/g\x2C '')\n\n    if (buffer.match(/^[A-Z]+[0-9]+:[A-Z]+[0-9]+$/)) {\n        return new Range(buffer\x2C formula);\n    }\n    if (buffer.match(/^[^!]+![A-Z]+[0-9]+:[A-Z]+[0-9]+$/)) {\n        return new Range(buffer\x2C formula);\n    }\n    if (buffer.match(/^[A-Z]+:[A-Z]+$/)) {\n        return new Range(buffer\x2C formula);\n    }\n    if (buffer.match(/^[^!]+![A-Z]+:[A-Z]+$/)) {\n        return new Range(buffer\x2C formula);\n    }\n    if (buffer.match(/^[A-Z]+[0-9]+$/)) {\n        return new RefValue(buffer\x2C formula);\n    }\n    if (buffer.match(/^[^!]+![A-Z]+[0-9]+$/)) {\n        return new RefValue(buffer\x2C formula);\n    }\n    if (buffer.match(/%$/)) {\n        var inner = str_2_val(buffer.substr(0\x2C buffer.length-1)\x2C formula)\n        return new LazyValue(() => inner.calc() / 100)\n    }\n    if (getDefinedName(buffer\x2C formula)) {\n        return str_2_val(getDefinedName(buffer\x2C formula)\x2C formula);\n    }\n    return buffer;\n};\n
