es the p-norm of the vector\n  // In the case that a matrix is passed\x2C uses the first row as the vector\n  norm: function norm(arr\x2C p) {\n    var nnorm = 0\x2C\n    i = 0;\n    // check the p-value of the norm\x2C and set for most common case\n    if (isNaN(p)) p = 2;\n    // check if multi-dimensional array\x2C and make vector correction\n    if (isUsable(arr[0])) arr = arr[0];\n    // vector norm\n    for (; i < arr.length; i++) {\n      nnorm += Math.pow(Math.abs(arr[i])\x2C p);\n    }\n    return Math.pow(nnorm\x2C 1 / p);\n  }\x2C\n\n  // computes the angle between two vectors in rads\n  // In case a matrix is passed\x2C this uses the first row as the vector\n  angle: function angle(arr\x2C arg) {\n    return Math.acos(jStat.dot(arr\x2C arg) / (jStat.norm(arr) * jStat.norm(arg)));\n  }\x2C\n\n  // augment one matrix by another\n  // Note: this function returns a matrix\x2C not a jStat object\n  aug: function aug(a\x2C b) {\n    var newarr = [];\n    var i;\n    for (i = 0; i < a.length; i++) {\n      newarr.push(a[i].slice());\n    }\n    for (i = 0; i < newarr.length; i++) {\n      push.apply(newarr[i]\x2C b[i]);\n    }\n    return newarr;\n  }\x2C\n\n  // The inv() function calculates the inverse of a matrix\n  // Create the inverse by augmenting the matrix by the identity matrix of the\n  // appropriate size\x2C and then use G-J elimination on the augmented matrix.\n  inv: function inv(a) {\n    var rows = a.length;\n    var cols = a[0].length;\n    var b = jStat.identity(rows\x2C cols);\n    var c = jStat.gauss_jordan(a\x2C b);\n    var result = [];\n    var i = 0;\n    var j;\n\n    //We need to copy the inverse portion to a new matrix to rid G-J artifacts\n    for (; i < rows; i++) {\n      result[i] = [];\n      for (j = cols; j < c[0].length; j++)\n        result[i][j - cols] = c[i][j];\n    }\n    return result;\n  }\x2C\n\n  // calculate the determinant of a matrix\n  det: function det(a) {\n    if (a.length === 2) {\n      return a[0][0] * a[1]