script-source,160,/Users/lukedunscombe/src/kmodo/xlsx-calc/node_modules/cli-progress/lib/format-value.js,// default value format (apply autopadding)\n\n// format valueset\nmodule.exports = function formatValue(v\x2C options\x2C type){\n    // no autopadding ? passthrough\n    if (options.autopadding !== true){\n        return v;\n    }\n\n    // padding\n    function autopadding(value\x2C length){\n        return (options.autopaddingChar + value).slice(-length);\n    }\n\n    switch (type){\n        case 'percentage':\n            return autopadding(v\x2C 3);\n\n        default:\n            return v;\n    }\n}
