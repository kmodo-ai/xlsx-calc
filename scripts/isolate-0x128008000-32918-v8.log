cdf(x\x2C mu\x2C sigma) {\n    if (x < 0)\n      return 0;\n    return 0.5 +\n        (0.5 * jStat.erf((Math.log(x) - mu) / Math.sqrt(2 * sigma * sigma)));\n  }\x2C\n\n  inv: function(p\x2C mu\x2C sigma) {\n    return Math.exp(-1.41421356237309505 * sigma * jStat.erfcinv(2 * p) + mu);\n  }\x2C\n\n  mean: function mean(mu\x2C sigma) {\n    return Math.exp(mu + sigma * sigma / 2);\n  }\x2C\n\n  median: function median(mu/*\x2C sigma*/) {\n    return Math.exp(mu);\n  }\x2C\n\n  mode: function mode(mu\x2C sigma) {\n    return Math.exp(mu - sigma * sigma);\n  }\x2C\n\n  sample: function sample(mu\x2C sigma) {\n    return Math.exp(jStat.randn() * sigma + mu);\n  }\x2C\n\n  variance: function variance(mu\x2C sigma) {\n    return (Math.exp(sigma * sigma) - 1) * Math.exp(2 * mu + sigma * sigma);\n  }\n});\n\n\n\n// extend noncentralt function with static methods\njStat.extend(jStat.noncentralt\x2C {\n  pdf: function pdf(x\x2C dof\x2C ncp) {\n    var tol = 1e-14;\n    if (Math.abs(ncp) < tol)  // ncp approx 0; use student-t\n      return jStat.studentt.pdf(x\x2C dof)\n\n    if (Math.abs(x) < tol) {  // different formula for x == 0\n      return Math.exp(jStat.gammaln((dof + 1) / 2) - ncp * ncp / 2 -\n                      0.5 * Math.log(Math.PI * dof) - jStat.gammaln(dof / 2));\n    }\n\n    // formula for x != 0\n    return dof / x *\n        (jStat.noncentralt.cdf(x * Math.sqrt(1 + 2 / dof)\x2C dof+2\x2C ncp) -\n         jStat.noncentralt.cdf(x\x2C dof\x2C ncp));\n  }\x2C\n\n  cdf: function cdf(x\x2C dof\x2C ncp) {\n    var tol = 1e-14;\n    var min_iterations = 200;\n\n    if (Math.abs(ncp) < tol)  // ncp approx 0; use student-t\n      return jStat.studentt.cdf(x\x2C dof);\n\n    // turn negative x into positive and flip result afterwards\n    var flip = false;\n    if (x < 0) {\n      flip = true;\n      ncp = -ncp;\n    }\n\n    var prob = jStat.normal.cdf(-ncp\x2C 0\x2C 1);\n    var value = tol + 1;\n    // use value at last two steps to determine convergence\n    var lastvalue = value;\n    var y = x * x / (x * x + dof);\n    var j = 0;\n    var p = Math.exp(-ncp * ncp / 2);\n    var q = Math.exp(-ncp * ncp / 2 - 0.5 * Math.log(2) -\n                     jStat.gammaln(3 / 2)) * ncp;\n    while (j < min_iterations || lastvalue > tol || value > tol) {\n      lastvalue = value;\n      if (j > 0) {\n        p *= (ncp * ncp) / (2 * j);\n        q *= (ncp * ncp) / (2 * (j + 1 / 2));\n      }\n      value = p * jStat.beta.cdf(y\x2C j + 0.5\x2C dof / 2) +\n          q * jStat.beta.cdf(y\x2C j+1\x2C dof/2);\n      prob += 0.5 * value;\n      j++;\n    }\n\n    return flip ? (1 - prob) : prob;\n  }\n});\n\n\n// extend normal function with static methods\njStat.extend(jStat.normal\x2C {\n  pdf: function pdf(x\x2C mean\x2C std) {\n    return Math.exp(-0.5 * Math.log(2 * Math.PI) -\n                    Math.log(std) - Math.pow(x - mean\x2C 2) / (2 * std * std));\n  }\x2C\n\n  cdf: function cdf(x\x2C mean\x2C std) {\n    return 0.5 * (1 + jStat.erf((x - mean) / Math.sqrt(2 * std * std)));\n  }\x2C\n\n  inv: function(p\x2C mean\x2C std) {\n    return -1.41421356237309505 * std * jStat.erfcinv(2 * p) + mean;\n  }\x2C\n\n  mean : function(mean/*\x2C std*/) {\n    return mean;\n  }\x2C\n\n  median: function median(mean/*\x2C std*/) {\n    return mean;\n  }\x2C\n\n  mode: function (mean/*\x2C std*/) {\n    return mean;\n  }\x2C\n\n  sample: function sample(mean\x2C std) {\n    return jStat.randn() * std + mean;\n  }\x2C\n\n  variance : function(mean\x2C std) {\n    return std * std;\n  }\n});\n\n\n\n// extend pareto function with static methods\njStat.extend(jStat.pareto\x2C {\n  pdf: function pdf(x\x2C scale\x2C shape) {\n    if (x < scale)\n      return 0;\n    return (shape * Math.pow(scale\x2C shape)) / Math.pow(x\x2C shape + 1);\n  }\x2C\n\n  cdf: function cdf(x\x2C scale\x2C shape) {\n    if (x < scale)\n      return 0;\n    return 1 - Math.pow(scale / x\x2C shape);\n  }\x2C\n\n  inv: function inv(p\x2C scale\x2C shape) {\n    return scale / Math.pow(1 - p\x2C 1 / shape);\n  }\x2C\n\n  mean: function mean(scale\x2C shape) {\n    if (shape <= 1)\n      return undefined;\n    return (shape * Math.pow(scale\x2C shape)) / (shape - 1);\n  }\x2C\n\n  median: function median(scale\x2C shape) {\n    return scale * (shape * Math.SQRT2);\n  }\x2C\n\n  mode: function mode(scale/*\x2C shape*/) {\n    return scale;\n  }\x2C\n\n  variance : function(scale\x2C shape) {\n    if (shape <= 2)\n      return undefined;\n    return (scale*scale * shape) / (Math.pow(shape - 1\x2C 2) * (shape - 2));\n  }\n});\n\n\n\n// extend studentt function with static methods\njStat.extend(jStat.studentt\x2C {\n  pdf: function pdf(x\x2C dof) {\n    dof = dof > 1e100 ? 1e100 : dof;\n    return (1/(Math.sqrt(dof) * jStat.betafn(0.5\x2C dof/2))) *\n        Math.pow(1 + ((x * x) / dof)\x2C -((dof + 1) / 2));\n  }\x2C\n\n  cdf: function cdf(x\x2C dof) {\n    var dof2 = dof / 2;\n    return jStat.ibeta((x + Math.sqrt(x * x + dof)) /\n                       (2 * Math.sqrt(x * x + dof))\x2C dof2\x2C dof2);\n  }\x2C\n\n  inv: function(p\x2C dof) {\n    var x = jStat.ibetainv(2 * Math.min(p\x2C 1 - p)\x2C 0.5 * dof\x2C 0.5);\n    x = Math.sqrt(dof * (1 - x) / x);\n    return (p > 0.5) ? x : -x;\n  }\x2C\n\n  mean: function mean(dof) {\n    return (dof > 1) ? 0 : undefined;\n  }\x2C\n\n  median: function median(/*dof*/) {\n    return 0;\n  }\x2C\n\n  mode: function mode(/*dof*/) {\n    return 0;\n  }\x2C\n\n  sample: function sample(dof) {\n    return jStat.randn() * Math.sqrt(dof / (2 * jStat.randg(dof / 2)));\n  }\x2C\n\n  variance: function variance(dof) {\n    return (dof  > 2) ? dof / (dof - 2) : (dof > 1) ? Infinity : undefined;\n  }\n});\n\n\n\n// extend weibull function with static methods\njStat.extend(jStat.weibull\x2C {\n  pdf: function pdf(x\x2C scale\x2C shape) {\n    if (x < 0 || scale < 0 || shape < 0)\n      return 0;\n    return (shape / scale) * Math.pow((x / scale)\x2C (shape - 1)) *\n        Math.exp(-(Math.pow((x / scale)\x2C shape)));\n  }\x2C\n\n  cdf: function cdf(x\x2C scale\x2C shape) {\n    return x < 0 ? 0 : 1 - Math.exp(-Math.pow((x / scale)\x2C shape));\n  }\x2C\n\n  inv: function(p\x2C scale\x2C shape) {\n    return scale * Math.pow(-Math.log(1 - p)\x2C 1 / shape);\n  }\x2C\n\n  mean : function(scale\x2C shape) {\n    return scale * jStat.gammafn(1 + 1 / shape);\n  }\x2C\n\n  median: function median(scale\x2C shape) {\n    return scale * Math.pow(Math.log(2)\x2C 1 / shape);\n  }\x2C\n\n  mode: function mode(scale\x2C shape) {\n    if (shape <= 1)\n      return 0;\n    return scale * Math.pow((shape - 1) / shape\x2C 1 / shape);\n  }\x2C\n\n  sample: function sample(scale\x2C shape) {\n    return scale * Math.pow(-Math.log(jStat._random_fn())\x2C 1 / shape);\n  }\x2C\n\n  variance: function variance(scale\x2C shape) {\n    return scale * scale * jStat.gammafn(1 + 2 / shape) -\n        Math.pow(jStat.weibull.mean(scale\x2C shape)\x2C 2);\n  }\n});\n\n\n\n// extend uniform function with static methods\njStat.extend(jStat.uniform\x2C {\n  pdf: function pdf(x\x2C a\x2C b) {\n    return (x < a || x > b) ? 0 : 1 / (b - a);\n  }\x2C\n\n  cdf: function cdf(x\x2C a\x2C b) {\n    if (x < a)\n      return 0;\n    else if (x < b)\n      return (x - a) / (b - a);\n    return 1;\n  }\x2C\n\n  inv: function(p\x2C a\x2C b) {\n    return a + (p * (b - a));\n  }\x2C\n\n  mean: function mean(a\x2C b) {\n    return 0.5 * (a + b);\n  }\x2C\n\n  median: function median(a\x2C b) {\n    return jStat.mean(a\x2C b);\n  }\x2C\n\n  mode: function mode(/*a\x2C b*/) {\n    throw new Error('mode is not yet implemented');\n  }\x2C\n\n  sample: function sample(a\x2C b) {\n    return (a / 2 + b / 2) + (b / 2 - a / 2) * (2 * jStat._random_fn() - 1);\n  }\x2C\n\n  variance: function variance(a\x2C b) {\n    return Math.pow(b - a\x2C 2) / 12;\n  }\n});\n\n\n// Got this from http://www.math.ucla.edu/~tom/distributions/binomial.html\nfunction betinc(x\x2C a\x2C b\x2C eps) {\n  var a0 = 0;\n  var b0 = 1;\n  var a1 = 1;\n  var b1 = 1;\n  var m9 = 0;\n  var a2 = 0;\n  var c9;\n\n  while (Math.abs((a1 - a2) / a1) > eps) {\n    a2 = a1;\n    c9 = -(a + m9) * (a + b + m9) * x / (a + 2 * m9) / (a + 2 * m9 + 1);\n    a0 = a1 + c9 * a0;\n    b0 = b1 + c9 * b0;\n    m9 = m9 + 1;\n    c9 = m9 * (b - m9) * x / (a + 2 * m9 - 1) / (a + 2 * m9);\n    a1 = a0 + c9 * a1;\n    b1 = b0 + c9 * b1;\n    a0 = a0 / b1;\n    b0 = b0 / b1;\n    a1 = a1 / b1;\n    b1 = 1;\n  }\n\n  return a1 / a;\n}\n\n\n// extend uniform function with static methods\njStat.extend(jStat.binomial\x2C {\n  pdf: function pdf(k\x2C n\x2C p) {\n    return (p === 0 || p === 1) ?\n      ((n * p) === k ? 1 : 0) :\n      jStat.combination(n\x2C k) * Math.pow(p\x2C k) * Math.pow(1 - p\x2C n - k);\n  }\x2C\n\n  cdf: function cdf(x\x2C n\x2C p) {\n    var betacdf;\n    var eps = 1e-10;\n\n    if (x < 0)\n      return 0;\n    if (x >= n)\n      return 1;\n    if (p < 0 || p > 1 || n <= 0)\n      return NaN;\n\n    x = Math.floor(x);\n    var z = p;\n    var a = x + 1;\n    var b = n - x;\n    var s = a + b;\n    var bt = Math.exp(jStat.gammaln(s) - jStat.gammaln(b) -\n                      jStat.gammaln(a) + a * Math.log(z) + b * Math.log(1 - z));\n\n    if (z < (a + 1) / (s + 2))\n      betacdf = bt * betinc(z\x2C a\x2C b\x2C eps);\n    else\n      betacdf = 1 - bt * betinc(1 - z\x2C b\x2C a\x2C eps);\n\n    return Math.round((1 - betacdf) * (1 / eps)) / (1 / eps);\n  }\n});\n\n\n\n// extend uniform function with static methods\njStat.extend(jStat.negbin\x2C {\n  pdf: function pdf(k\x2C r\x2C p) {\n    if (k !== k >>> 0)\n      return false;\n    if (k < 0)\n      return 0;\n    return jStat.combination(k + r - 1\x2C r - 1) *\n        Math.pow(1 - p\x2C k) * Math.pow(p\x2C r);\n  }\x2C\n\n  cdf: function cdf(x\x2C r\x2C p) {\n    var sum = 0\x2C\n    k = 0;\n    if (x < 0) return 0;\n    for (; k <= x; k++) {\n      sum += jStat.negbin.pdf(k\x2C r\x2C p);\n    }\n    return sum;\n  }\n});\n\n\n\n// extend uniform function with static methods\njStat.extend(jStat.hypgeom\x2C {\n  pdf: function pdf(k\x2C N\x2C m\x2C n) {\n    // Hypergeometric PDF.\n\n    // A simplification of the CDF algorithm below.\n\n    // k = number of successes drawn\n    // N = population size\n    // m = number of successes in population\n    // n = number of items drawn from population\n\n    if(k !== k | 0) {\n      return false;\n    } else if(k < 0 || k < m - (N - n)) {\n      // It's impossible to have this few successes drawn.\n      return 0;\n    } else if(k > n || k > m) {\n      // It's impossible to have this many successes drawn.\n      return 0;\n    } else if (m * 2 > N) {\n      // More than half the population is successes.\n\n      if(n * 2 > N) {\n        // More than half the population is sampled.\n\n        return jStat.hypgeom.pdf(N - m - n + k\x2C N\x2C N - m\x2C N - n)\n      } else {\n        // Half or less of the population is sampled.\n\n        return jStat.hypgeom.pdf(n - k\x2C N\x2C N - m\x2C n);\n      }\n\n    } else if(n * 2 > N) {\n      // Half or less is successes.\n\n      return jStat.hypgeom.pdf(m - k\x2C N\x2C m\x2C N - n);\n\n    } else if(m < n) {\n      // We want to have the number of things sampled to be less than the\n      // successes available. So swap the definitions of successful and sampled.\n      return jStat.hypgeom.pdf(k\x2C N\x2C n\x2C m);\n    } else {\n      // If we get here\x2C half or less of the population was sampled\x2C half or\n      // less of it was successes\x2C and we had fewer sampled things than\n      // successes. Now we can do this complicated iterative algorithm in an\n      // efficient way.\n\n      // The basic premise of the algorithm is that we partially normalize our\n      // intermediate product to keep it in a numerically good region\x2C and then\n      // finish the normalization at the end.\n\n      // This variable holds the scaled probability of the current number of\n      // successes.\n      var scaledPDF = 1;\n\n      // This keeps track of how much we have normalized.\n      var samplesDone = 0;\n\n      for(var i = 0; i < k; i++) {\n        // For every possible number of successes up to that observed...\n\n        while(scaledPDF > 1 && samplesDone < n) {\n          // Intermediate result is growing too big. Apply some of the\n          // normalization to shrink everything.\n\n          scaledPDF *= 1 - (m / (N - samplesDone));\n\n          // Say we've normalized by this sample already.\n          samplesDone++;\n        }\n\n        // Work out the partially-normalized hypergeometric PDF for the next\n        // number of successes\n        scaledPDF *= (n - i) * (m - i) / ((i + 1) * (N - m - n + i + 1));\n      }\n\n      for(; samplesDone < n; samplesDone++) {\n        // Apply all the rest of the normalization\n        scaledPDF *= 1 - (m / (N - samplesDone));\n      }\n\n      // Bound answer sanely before returning.\n      return Math.min(1\x2C Math.max(0\x2C scaledPDF));\n    }\n  }\x2C\n\n  cdf: function cdf(x\x2C N\x2C m\x2C n) {\n    // Hypergeometric CDF.\n\n    // This algorithm is due to Prof. Thomas S. Ferguson\x2C <tom@math.ucla.edu>\x2C\n    // and comes from his hypergeometric test calculator at\n    // <http://www.math.ucla.edu/~tom/distributions/Hypergeometric.html>.\n\n    // x = number of successes drawn\n    // N = population size\n    // m = number of successes in population\n    // n = number of items drawn from population\n\n    if(x < 0 || x < m - (N - n)) {\n      // It's impossible to have this few successes drawn or fewer.\n      return 0;\n    } else if(x >= n || x >= m) {\n      // We will always have this many successes or fewer.\n      return 1;\n    } else if (m * 2 > N) {\n      // More than half the population is successes.\n\n      if(n * 2 > N) {\n        // More than half the population is sampled.\n\n        return jStat.hypgeom.cdf(N - m - n + x\x2C N\x2C N - m\x2C N - n)\n      } else {\n        // Half or less of the population is sampled.\n\n        return 1 - jStat.hypgeom.cdf(n - x - 1\x2C N\x2C N - m\x2C n);\n      }\n\n    } else if(n * 2 > N) {\n      // Half or less is successes.\n\n      return 1 - jStat.hypgeom.cdf(m - x - 1\x2C N\x2C m\x2C N - n);\n\n    } else if(m < n) {\n      // We want to have the number of things sampled to be less than the\n      // successes available. So swap the definitions of successful and sampled.\n      return jStat.hypgeom.cdf(x\x2C N\x2C n\x2C m);\n    } else {\n      // If we get here\x2C half or less of the population was sampled\x2C half or\n      // less of it was successes\x2C and we had fewer sampled things than\n      // successes. Now we can do this complicated iterative algorithm in an\n      // efficient way.\n\n      // The basic premise of the algorithm is that we partially normalize our\n      // intermediate sum to keep it in a numerically good region\x2C and then\n      // finish the normalization at the end.\n\n      // Holds the intermediate\x2C scaled total CDF.\n      var scaledCDF = 1;\n\n      // This variable holds the scaled probability of the current number of\n      // successes.\n      var scaledPDF = 1;\n\n      // This keeps track of how much we have normalized.\n      var samplesDone = 0;\n\n      for(var i = 0; i < x; i++) {\n        // For every possible number of successes up to that observed...\n\n        while(scaledCDF > 1 && samplesDone < n) {\n          // Intermediate result is growing too big. Apply some of the\n          // normalization to shrink everything.\n\n          var factor = 1 - (m / (N - samplesDone));\n\n          scaledPDF *= factor;\n          scaledCDF *= factor;\n\n          // Say we've normalized by this sample already.\n          samplesDone++;\n        }\n\n        // Work out the partially-normalized hypergeometric PDF for the next\n        // number of successes\n        scaledPDF *= (n - i) * (m - i) / ((i + 1) * (N - m - n + i + 1));\n\n        // Add to the CDF answer.\n        scaledCDF += scaledP