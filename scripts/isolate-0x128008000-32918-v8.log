ps://svn.r-project.org/R/trunk/src/nmath/df.c\n  pdf: function pdf(x\x2C df1\x2C df2) {\n    var p\x2C q\x2C f;\n\n    if (x < 0)\n      return 0;\n\n    if (df1 <= 2) {\n      if (x === 0 && df1 < 2) {\n        return Infinity;\n      }\n      if (x === 0 && df1 === 2) {\n        return 1;\n      }\n      return (1 / jStat.betafn(df1 / 2\x2C df2 / 2)) *\n              Math.pow(df1 / df2\x2C df1 / 2) *\n              Math.pow(x\x2C (df1/2) - 1) *\n              Math.pow((1 + (df1 / df2) * x)\x2C -(df1 + df2) / 2);\n    }\n\n    p = (df1 * x) / (df2 + x * df1);\n    q = df2 / (df2 + x * df1);\n    f = df1 * q / 2.0;\n    return f * jStat.binomial.pdf((df1 - 2) / 2\x2C (df1 + df2 - 2) / 2\x2C p);\n  }\x2C\n\n  cdf: function cdf(x\x2C df1\x2C df2) {\n    if (x < 0)\n      return 0;\n    return jStat.ibeta((df1 * x) / (df1 * x + df2)\x2C df1 / 2\x2C df2 / 2);\n  }\x2C\n\n  inv: function inv(x\x2C df1\x2C df2) {\n    return df2 / (df1 * (1 / jStat.ibetainv(x\x2C df1 / 2\x2C df2 / 2) - 1));\n  }\x2C\n\n  mean: function mean(df1\x2C df2) {\n    return (df2 > 2) ? df2 / (df2 - 2) : undefined;\n  }\x2C\n\n  mode: function mode(df1\x2C df2) {\n    return (df1 > 2) ? (df2 * (df1 - 2)) / (df1 * (df2 + 2)) : undefined;\n  }\x2C\n\n  // return a random sample\n  sample: function sample(df1\x2C df2) {\n    var x1 = jStat.randg(df1 / 2) * 2;\n    var x2 = jStat.randg(df2 / 2) * 2;\n    return (x1 / df1) / (x2 / df2);\n  }\x2C\n\n  variance: function variance(df1\x2C df2) {\n    if (df2 <= 4)\n      return undefined;\n    return 2 * df2 * df2 * (df1 + df2 - 2) /\n        (df1 * (df2 - 2) * (df2 - 2) * (df2 - 4));\n  }\n});\n\n\n// extend cauchy function with static methods\njStat.extend(jStat.cauchy\x2C {\n  pdf: function pdf(x\x2C local\x2C scale) {\n    if (scale < 0) { return 0; }\n\n    return (scale / (Math.pow(x - local\x2C 2) + Math.pow(scale\x2C 2))) / Math.PI;\n  }\x2C\n\n  cdf: function cdf(x\x2C local\x2C scale) {\n    return Math.atan((x - local) / scale) / Math.PI + 0.5