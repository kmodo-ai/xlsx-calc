script-source,136,/Users/lukedunscombe/src/kmodo/xlsx-calc/src/UserRawFnExecutor.js,"use strict";\n\nmodule.exports = function UserRawFnExecutor(user_function\x2C formula) {\n    var self = this;\n    self.name = 'UserRawFn';\n    self.args = [];\n    self.calc = function() {\n        try {\n            return user_function.apply(self\x2C self.args);\n        } catch(e) {\n            // debug\n            // console.log('----------------'\x2C user_function);\n            // console.log(formula.name);\n            // console.log(self);\n            throw e;\n        }\n    };\n    self.push = function(buffer) {\n        self.args.push(buffer);\n    };\n};\n
