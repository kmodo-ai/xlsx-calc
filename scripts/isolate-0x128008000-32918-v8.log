script-source,123,/Users/lukedunscombe/src/kmodo/xlsx-calc/src/col_str_2_int.js,"use strict";\n\nmodule.exports = function col_str_2_int(col_str) {\n    var r = 0;\n    var colstr = col_str.replace(/[0-9]+$/\x2C '');\n    for (var i = colstr.length; i--;) {\n        r += Math.pow(26\x2C colstr.length - i - 1) * (colstr.charCodeAt(i) - 64);\n    }\n    return r - 1;\n};
