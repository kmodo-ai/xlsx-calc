script-source,140,/Users/lukedunscombe/src/kmodo/xlsx-calc/src/find_all_cells_with_formulas.js,"use strict";\n\nmodule.exports = function find_all_cells_with_formulas(wb\x2C exec_formula) {\n    let formula_ref = {};\n    let cells = [];\n    for (let sheet_name in wb.Sheets) {\n        let sheet = wb.Sheets[sheet_name];\n        for (let cell_name in sheet) {\n            if (sheet[cell_name] && sheet[cell_name].f) {\n                let formula = formula_ref[sheet_name + '!' + cell_name] = {\n                    formula_ref: formula_ref\x2C\n                    wb: wb\x2C\n                    sheet: sheet\x2C\n                    sheet_name: sheet_name\x2C\n                    cell: sheet[cell_name]\x2C\n                    name: cell_name\x2C\n                    status: 'new'\x2C\n                    exec_formula: exec_formula\n                };\n                cells.push(formula);\n            }\n        }\n    }\n    return cells;\n};\n
