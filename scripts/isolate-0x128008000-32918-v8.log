script-source,163,/Users/lukedunscombe/src/kmodo/xlsx-calc/node_modules/cli-progress/lib/options.js,// utility to merge defaults\nfunction mergeOption(v\x2C defaultValue){\n    if (typeof v === 'undefined' || v === null){\n        return defaultValue;\n    }else{\n        return v;\n    }\n}\n\nmodule.exports = {\n    // set global options\n    parse: function parse(rawOptions\x2C preset){\n\n        // options storage\n        const options = {};\n\n        // merge preset\n        const opt = Object.assign({}\x2C preset\x2C rawOptions);\n\n        // the max update rate in fps (redraw will only triggered on value change)\n        options.throttleTime = 1000 / (mergeOption(opt.fps\x2C 10));\n\n        // the output stream to write on\n        options.stream = mergeOption(opt.stream\x2C process.stderr);\n\n        // external terminal provided ?\n        options.terminal = mergeOption(opt.terminal\x2C null);\n\n        // clear on finish ?\n        options.clearOnComplete = mergeOption(opt.clearOnComplete\x2C false);\n\n        // stop on finish ?\n        options.stopOnComplete = mergeOption(opt.stopOnComplete\x2C false);\n\n        // size of the progressbar in chars\n        options.barsize = mergeOption(opt.barsize\x2C 40);\n\n        // position of the progress bar - 'left' (default)\x2C 'right' or 'center'\n        options.align = mergeOption(opt.align\x2C 'left');\n\n        // hide the cursor ?\n        options.hideCursor = mergeOption(opt.hideCursor\x2C false);\n\n        // disable linewrapping ?\n        options.linewrap = mergeOption(opt.linewrap\x2C false);\n\n        // glue sequence (control chars) between bar elements ?\n        options.barGlue = mergeOption(opt.barGlue\x2C '');\n\n        // bar chars\n        options.barCompleteChar = mergeOption(opt.barCompleteChar\x2C '=');\n        options.barIncompleteChar = mergeOption(opt.barIncompleteChar\x2C '-');\n\n        // the bar format\n        options.format = mergeOption(opt.format\x2C 'progress [{bar}] {percentage}% | ETA: {eta}s | {value}/{total}');\n\n        // external time-format provided ?\n        options.formatTime = mergeOption(opt.formatTime\x2C null);\n\n        // external value-format provided ?\n        options.formatValue = mergeOption(opt.formatValue\x2C null);\n\n        // external bar-format provided ?\n        options.formatBar = mergeOption(opt.formatBar\x2C null);\n\n        // the number of results to average ETA over\n        options.etaBufferLength = mergeOption(opt.etaBuffer\x2C 10);\n\n        // automatic eta updates based on fps\n        options.etaAsynchronousUpdate = mergeOption(opt.etaAsynchronousUpdate\x2C false);\n\n        // progress calculation relative to start value ? default start at 0\n        options.progressCalculationRelative = mergeOption(opt.progressCalculationRelative\x2C false);\n\n        // allow synchronous updates ?\n        options.synchronousUpdate = mergeOption(opt.synchronousUpdate\x2C true);\n\n        // notty mode\n        options.noTTYOutput = mergeOption(opt.noTTYOutput\x2C false);\n\n        // schedule - 2s\n        options.notTTYSchedule = mergeOption(opt.notTTYSchedule\x2C 2000);\n        \n        // emptyOnZero - false\n        options.emptyOnZero = mergeOption(opt.emptyOnZero\x2C false);\n\n        // force bar redraw even if progress did not change\n        options.forceRedraw = mergeOption(opt.forceRedraw\x2C false);\n\n        // automated padding to fixed width ?\n        options.autopadding = mergeOption(opt.autopadding\x2C false);\n\n        // stop bar on SIGINT/SIGTERM to restore cursor settings ?\n        options.gracefulExit = mergeOption(opt.gracefulExit\x2C false);\n\n        return options;\n    }\x2C\n\n    // derived options: instance specific\x2C has to be created for every bar element\n    assignDerivedOptions: function assignDerivedOptions(options){\n        // pre-render bar strings (performance)\n        options.barCompleteString = options.barCompleteChar.repeat(options.b